# Copia este archivo a .env.local y llena los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta (developers.facebook.com → tu app)
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
# ID de la configuración de Facebook Login for Business (Embedded Signup)
NEXT_PUBLIC_META_CONFIG_ID=
# Texto secreto que tú inventas y pegas también en WhatsApp → Configuración → Webhook
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
